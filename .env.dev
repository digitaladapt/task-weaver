# TaskWeaver — committed DEV environment defaults.
#
# Loaded automatically by Symfony's Dotenv when APP_ENV=dev (the default on
# a fresh checkout when no APP_ENV is set). Create an uncommitted
# .env.dev.local file to override anything here for your machine — those
# overrides are git-ignored and never shared.
#
# Production never uses this file; see .env.example (committed reference)
# and inject real environment variables via your runtime instead.

APP_ENV=dev

# Dev-only secret. Do NOT reuse in production — generate a fresh one there
# (see .env.example for how).
APP_SECRET=dev-only-change-me
APP_SHARE_DIR=var/share

###> symfony/routing ###
DEFAULT_URI=http://localhost
###< symfony/routing ###

###> doctrine/doctrine-bundle ###
# SQLite is the only database in v1 (SPEC.md -> Development Notes).
DATABASE_URL="sqlite:///%kernel.project_dir%/var/taskweaver.db"
###< doctrine/doctrine-bundle ###

###> symfony/messenger ###
# Messenger uses the same SQLite database as its transport (doctrine://default).
# auto_setup=1 lets it create the messenger tables on first use in dev.
###< symfony/messenger ###

###> TaskWeaver tunables (SPEC.md -> Configuration) ###
# Number of tool call rounds a step may take before it is considered to be looping.
TASKWEAVER_MAX_ROUNDS=50

# Seconds a step may stay `running` before it's considered expired.
# Used to set Step.expires_at when the step is marked running; enforced lazily.
TASKWEAVER_STEP_TIMEOUT=600

# Two-clock step liveness (docs/step-liveness-plan.md §3.8).
#
# STEP_TIMEOUT (above) is the END-TO-END budget — never refreshed.
# STEP_IDLE_TIMEOUT is the ROLLING budget: max seconds of silence between
# activities (LLM calls, tool calls, streamed-output progress beats) before
# the step is reaped as a stalled worker.
TASKWEAVER_STEP_IDLE_TIMEOUT=120

# Head start the worker takes on both clocks: it aborts at
# `deadline - grace` so it can still submit partial results instead of being
# cut off empty-handed by the controller.
TASKWEAVER_STEP_GRACE=15

# Step context budget: max-context = request-size + output-buffer-size.
TASKWEAVER_CONTEXT_REQUEST_SIZE=6000
TASKWEAVER_CONTEXT_OUTPUT_BUFFER=1500

# Worker's LLM-call concurrency limit, issued to the worker in its config.
TASKWEAVER_LLM_MAX_CONCURRENCY=1

# One-time enrollment token a worker presents at provision time (Tier-0).
TASKWEAVER_ENROLLMENT_TOKEN=dev-enrollment-token

# Local LLM (direct, unauthenticated) endpoint + default model.
# If TASKWEAVER_LLM_API_KEY is set, this becomes the upstream that the
# controller proxies to via /api/worker/llm (workers never hold the key).
TASKWEAVER_LLM_URL=http://llm:8080/v1
# Model discovery cache TTL seconds (0 = always fetch; docs/model-selection-plan.md M3b)
TASKWEAVER_LLM_MODELS_CACHE_TTL=300
TASKWEAVER_LLM_MODEL=Qwen3.5-4B

# API key for an external/keyed LLM provider. Leave empty for a direct local
# LLM. Held only by the controller; never issued to workers.
TASKWEAVER_LLM_API_KEY=

# Optional system-prompt override issued to workers in provision config.
TASKWEAVER_SYSTEM_PROMPT_OVERRIDE=

# Deployment-wide timezone for ALL timestamps. Empty → OS/system timezone
# (TZ env → /etc/timezone → /etc/localtime → PHP default). Wall-clock in
# this zone, never UTC-converted.
TASKWEAVER_TIMEZONE=
###< TaskWeaver tunables ###

###> MCP server credentials (v1: env vars only, names referenced in DB) ###
# Each McpServer row's cred_vars lists WHICH env vars map to its auth.
# Add placeholder values here for local dev servers; real secrets go in
# .env.dev.local or into the production environment.
# Example:
# MY_DEV_MCP_SERVER_TOKEN=dev-only-placeholder
###< MCP server credentials ###
