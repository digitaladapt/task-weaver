# In all environments, the following files are loaded if they exist,
# the latter taking precedence over the former:
#
#   * .env                contains default values for the environment variables needed by the app
#   * .env.local          uncommitted file with local overrides
#   * .env.$APP_ENV       committed environment-specific defaults
#   * .env.$APP_ENV.local uncommitted environment-specific overrides
#
# Real environment variables win over .env files.
#
# symfony/dotenv is a DEV-ONLY dependency. In production there is no .env;
# real environment variables are injected by the runtime.
# See SPEC.md → Configuration.
#
# Run "composer dump-env prod" to compile .env files for production use.

###> symfony/framework-bundle ###
APP_ENV=dev
APP_SECRET=dev-only-change-me
APP_SHARE_DIR=var/share
###< symfony/framework-bundle ###

###> symfony/routing ###
# Configure how to generate URLs in non-HTTP contexts, such as CLI commands.
# See https://symfony.com/doc/current/routing.html#generating-urls-in-commands
DEFAULT_URI=http://localhost
###< symfony/routing ###

###> doctrine/doctrine-bundle ###
# SQLite is the only database in v1 (SPEC.md → Development Notes).
DATABASE_URL="sqlite:///%kernel.project_dir%/var/taskweaver.db"
###< doctrine/doctrine-bundle ###

###> symfony/messenger ###
# Messenger uses the same SQLite database as its transport (doctrine://default).
# auto_setup=1 lets it create the messenger tables on first use in dev.
MESSENGER_TRANSPORT_DSN=doctrine://default?auto_setup=1
###< symfony/messenger ###

###> TaskWeaver tunables (SPEC.md → Configuration) ###
# Seconds a step may stay `running` before it's considered expired.
# Used to set Step.expires_at when the step is marked running; enforced lazily.
TASKWEAVER_STEP_TIMEOUT=600

# Step context budget: max-context = request-size + output-buffer-size.
TASKWEAVER_CONTEXT_REQUEST_SIZE=6000
TASKWEAVER_CONTEXT_OUTPUT_BUFFER=1500

# Worker's LLM-call concurrency limit, issued to the worker in its config.
TASKWEAVER_LLM_MAX_CONCURRENCY=1

# One-time enrollment token a worker presents at provision time (Tier-0).
TASKWEAVER_ENROLLMENT_TOKEN=dev-enrollment-token
###< TaskWeaver tunables ###
