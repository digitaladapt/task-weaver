{% extends 'base.html.twig' %}

{% block title %}Tools · TaskWeaver{% endblock %}

{% block body %}
    <div class="page-head">
        <h1>Tools</h1>
        <span class="spacer"></span>
        <a class="btn btn-primary" href="{{ path('app_tool_server_new') }}">New Server</a>
    </div>
    <p class="subtitle">MCP servers and their tool definitions. Tools are tag-gated per step.</p>

    {% if servers is empty %}
        <div class="panel"><div class="empty">No MCP servers configured yet.</div></div>
    {% else %}
        <div class="panel">
            <div class="table-scroll">
            <table>
                <thead>
                    <tr>
                        <th>Name</th>
                        <th>Transport</th>
                        <th>Endpoint</th>
                        <th>Tools</th>
                        <th>Status</th>
                    </tr>
                </thead>
                <tbody>
                {% for server in servers %}
                    {% set live = server.toolDefs|filter(t => not t.removed)|length %}
                    {% set removed = server.toolDefs|length - live %}
                    <tr>
                        <td><a href="{{ path('app_tool_server_show', {id: server.id}) }}">{{ server.name }}</a></td>
                        <td><span class="badge mono">{{ server.transport }}</span></td>
                        <td class="mono muted">{{ server.endpoint }}</td>
                        <td>
                            {{ live }} live
                            {% if removed > 0 %}<span class="badge bg-yellow">{{ removed }} removed</span>{% endif %}
                        </td>
                        <td>{% if server.enabled %}<span class="badge bg-green">enabled</span>{% else %}<span class="badge bg-red">disabled</span>{% endif %}</td>
                    </tr>
                {% endfor %}
                </tbody>
            </table>
            </div>
        </div>
    {% endif %}
{% endblock %}
