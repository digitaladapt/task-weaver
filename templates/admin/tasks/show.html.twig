{% macro render_payload(value, label) %}
    {% set prepared = value|payload_prepare(label) %}
    <pre class="mono json-block">{{ prepared.json|json_encode(constant('JSON_PRETTY_PRINT')) }}</pre>
    {% if prepared.sections is not empty %}
        <div class="payload-rendered">
            <div class="rendered-title muted">rendered content</div>
            {% for section in prepared.sections %}
                <div class="rendered-section">
                    <div class="rendered-path mono">{{ section.path }}</div>
                    <div class="rendered-html">{{ section.html|raw }}</div>
                </div>
            {% endfor %}
        </div>
    {% endif %}
{% endmacro %}

{% extends 'base.html.twig' %}

{% block title %}{{ task.name }} · TaskWeaver{% endblock %}

{% block body %}
    <div class="page-head">
        <a href="{{ path('app_tasks') }}" class="btn btn-ghost">All tasks</a>
        <span class="spacer"></span>
        {% if task.status != 'running' %}
        <form method="post" action="{{ path('app_task_run', {id: task.id}) }}" class="inline">
            <input type="hidden" name="_csrf" value="{{ csrf_token('admin') }}">
            <button type="submit" class="btn btn-primary">Run</button>
        </form>
        {% endif %}
        <a class="btn" href="{{ path('app_task_edit', {id: task.id}) }}">Edit</a>
    </div>
    <h1>{{ task.name }}</h1>
    <p class="subtitle">
        <span class="badge status-{{ task.status }}">{{ task.status }}</span>
        <span class="muted">created {{ task.createdAt|date('Y-m-d H:i') }}</span>
        {% if task.priority %}<span class="badge">priority {{ task.priority }}</span>{% endif %}
        {% if task.schedule %}<span class="badge mono">{{ task.schedule }}</span>{% endif %}
        {% if task.nextRunAt %}<span class="badge">next run {{ task.nextRunAt|date('Y-m-d H:i') }}</span>{% endif %}
    </p>

    <div class="panel">
        <h3>Description</h3>
        <p>{{ task.description }}</p>
    </div>

    <div class="grid-2">
        <div class="panel">
            <h3>Steps ({{ task.steps|length }})</h3>
            {% for step in task.steps %}
                <div class="step-box {{ step.isFinal ? 'final' : '' }}">
                    <div style="display:flex; justify-content:space-between; align-items:center; gap:8px;">
                        <strong>{{ step.name }}</strong>
                        <span class="badge status-{{ step.status }}">{{ step.status }}</span>
                    </div>
                    <div class="muted" style="margin-top:4px;">{{ step.description }}</div>
                    <div style="margin-top:6px;">
                        {% for tag in step.tags %}<span class="tag">{{ tag }}</span>{% endfor %}
                        {% if step.isFinal %}<span class="badge bg-accent">final</span>{% endif %}
                    </div>
                    <div class="muted" style="margin-top:4px; font-size:12px;">
                        {% if step.startedAt %}started {{ step.startedAt|date('Y-m-d H:i') }}{% endif %}
                        {% if step.finishedAt %} · finished {{ step.finishedAt|date('Y-m-d H:i') }}{% endif %}
                        {% if step.expiresAt %} · expires {{ step.expiresAt|date('Y-m-d H:i') }}{% endif %}
                    </div>
                    {% if step.result %}
                        <details style="margin-top:6px;">
                            <summary class="muted" style="cursor:pointer;">result</summary>
                            {{ _self.render_payload(step.result, 'result') }}
                        </details>
                    {% endif %}
                </div>
            {% else %}
                <div class="empty">No steps for this task.</div>
            {% endfor %}
        </div>

        <div class="panel">
            <h3>Recent events ({{ task.events|length }})</h3>
            {% if task.events is empty %}
                <div class="empty">No events logged for this task yet.</div>
            {% else %}
            <ul class="timeline">
                {% for event in task.events|sort((a, b) => b.timestamp <=> a.timestamp) %}
                    <li class="type-{{ event.type }}">
                        <span class="t">{{ event.timestamp|date('Y-m-d H:i:s') }}</span>
                        <span class="badge type-{{ event.type }}">{{ event.type }}</span>
                        {% if event.worker %}<span class="muted" style="font-size:12px;">· {{ event.worker.name }}</span>{% endif %}
                        {% if event.step %}<span class="muted" style="font-size:12px;">· {{ event.step.name }}</span>{% endif %}
                        {% if event.payload is not empty %}
                            <details>
                                <summary class="muted" style="cursor:pointer;">payload</summary>
                                {{ _self.render_payload(event.payload, 'event.payload') }}
                            </details>
                        {% endif %}
                        {% if event.type in ['step_started', 'step_completed', 'step_failed'] %}
                            <form method="post" action="{{ path('app_conversation_followup') }}" class="inline" style="margin-top:4px;">
                                <input type="hidden" name="_csrf" value="{{ csrf_token('admin') }}">
                                <input type="hidden" name="event_id" value="{{ event.id }}">
                                <button type="submit" class="btn btn-small">Follow up</button>
                            </form>
                        {% endif %}
                        {% if event.toolCalls|length > 0 %}
                            <div class="ev-meta">
                                {% for tc in event.toolCalls %}
                                    <span class="tag">{{ tc.toolName }}</span>
                                {% endfor %}
                            </div>
                        {% endif %}
                    </li>
                {% endfor %}
            </ul>
            {% endif %}
        </div>
    </div>
{% endblock %}
