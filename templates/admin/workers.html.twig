{% extends 'base.html.twig' %}

{% block title %}Workers · TaskWeaver{% endblock %}

{% block body %}
    <h1>Workers</h1>
    <p class="subtitle">Registered worker containers and their controller-assigned capabilities.</p>

    {% if workers is empty %}
        <div class="panel"><div class="empty">No workers registered yet.</div></div>
    {% else %}
    <div class="panel">
        <table>
            <thead>
                <tr>
                    <th>Name</th>
                    <th>Tags</th>
                    <th>Internal tools</th>
                    <th>Created</th>
                    <th>Last seen</th>
                </tr>
            </thead>
            <tbody>
            {% for worker in workers %}
                <tr>
                    <td>{{ worker.name }}</td>
                    <td>
                        {% for tag in worker.tags %}<span class="tag">{{ tag }}</span>{% else %}<span class="muted">—</span>{% endfor %}
                    </td>
                    <td>
                        {% for t in worker.internalTools %}<span class="tag">{{ t }}</span>{% else %}<span class="muted">—</span>{% endfor %}
                    </td>
                    <td class="muted">{{ worker.createdAt|date('Y-m-d H:i') }}</td>
                    <td class="muted">{{ worker.lastSeenAt ? worker.lastSeenAt|date('Y-m-d H:i') : '—' }}</td>
                </tr>
            {% endfor %}
            </tbody>
        </table>
    </div>
    {% endif %}
{% endblock %}
