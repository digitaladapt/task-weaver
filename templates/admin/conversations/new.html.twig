{% extends 'base.html.twig' %}

{% block title %}New conversation · TaskWeaver{% endblock %}

{% block body %}
    <div class="page-head">
        <a href="{{ path('app_conversations') }}" class="btn btn-ghost">All conversations</a>
    </div>
    <h1>New conversation</h1>

    <div class="panel">
        <form method="post" action="{{ path('app_conversation_new') }}">
            <input type="hidden" name="_csrf" value="{{ csrf_token('admin') }}">
            <div style="margin-bottom:12px;">
                <label for="name" style="display:block; margin-bottom:4px;">Name</label>
                <input type="text" id="name" name="name" required style="width:100%; max-width:480px;" placeholder="e.g. Weekend plans">
            </div>
            <button type="submit" class="btn btn-primary">Create</button>
        </form>
    </div>
{% endblock %}
