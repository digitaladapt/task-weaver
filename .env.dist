# TaskWeaver — minimal committed BASE for Symfony's Dotenv.
#
# Symfony's runtime requires a base ".env" (or this ".env.dist") file to exist
# in order to boot — see loadEnv() in symfony/dotenv. It must contain NO
# secrets and NO environment-specific values: dev settings live in .env.dev,
# machine-local overrides in .env.local, and the production template in
# .env.example.
#
# On checkout, Symfony uses this file directly when ".env" is absent.
# You may copy it to ".env" (git-ignored) if you want a local base.

APP_ENV=dev

###> symfony/routing ###
DEFAULT_URI=http://localhost
###< symfony/routing ###
