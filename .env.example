# TaskWeaver — environment template (docker-compose reads this).
#
# COPY AND CUSTOMIZE:
#   cp .env.example .env
#
# docker compose automatically reads `.env` from the project directory
# (the compose file interpolates every value from it). If you deploy
# without compose, inject these as real environment variables via your
# runtime (container scheduler, secrets manager, systemd drop-in, etc.)
# instead — same variable names.
#
# For local development, see .env.dev (committed defaults) and your own
# uncommitted .env.dev.local / .env.local overrides.
#
# NOTE: in APP_ENV=prod the app REFUSES to boot when APP_SECRET or
# TASKWEAVER_ENROLLMENT_TOKEN is empty, a well-known placeholder, or too
# short — fail loudly instead of serving traffic with guessable secrets.

# --- Environment -----------------------------------------------------------
# 'prod' disables the dev toolbar, inlines/enables opcache-friendly caches,
# and turns off detailed error pages.
APP_ENV=prod

# Symfony secret used to sign cookies / CSRF tokens / session data.
# MUST be unique per deployment and kept secret.
# Generate one with:
#   php -r "echo bin2hex(random_bytes(32));"
#   # or:  openssl rand -hex 32
# If you lose it, all sessions and signed values are invalidated.
APP_SECRET=replace-me-with-a-long-random-hex-string

# Shared writable directory for cross-process data (uploads, caches spillover).
# In production this should point at a persistent volume.
APP_SHARE_DIR=/var/lib/taskweaver/share

###> symfony/routing ###
# Canonical URL used to generate absolute URLs in CLI/background contexts.
DEFAULT_URI=https://taskweaver.example.com
###< symfony/routing ###

###> doctrine/doctrine-bundle ###
# SQLite is the only supported database in v1.
# The path must be writable by the web/worker process user; in a container it
# must live on a persistent volume. The default `var/data/taskweaver.db` is
# under the volume-mounted `var/data` so attachments/uploads sit next to it.
# (Local dev may override to `var/data/dev.db` via .env.dev.local — see README.)
DATABASE_URL="sqlite:///%kernel.project_dir%/var/data/taskweaver.db"
###< doctrine/doctrine-bundle ###

###> symfony/messenger ###
# Messenger reuses the same SQLite DB as its transport.
# In production auto_setup should eventually be 0 once tables are migrated.
###< symfony/messenger ###

###> compose / worker deployment ###
# Values used by docker-compose.yml interpolation (see above). In prod set
# real secrets here; they are never committed (.gitignore excludes .env).
# APP_ENV=dev in .env gives you a seeded dev rig; APP_ENV=prod boots clean.

# Worker identity: image the worker reports at provision time. Known
# variants get server-mapped tags; unknown images are light workers that
# must declare capabilities below to be trusted with anything.
TASKWEAVER_WORKER_IMAGE=taskweaver/dev-worker:latest

# Comma-separated sandbox capabilities the worker declares (light workers
# only). Self-declarable set: terminal, php, node.
WORKER_CAPABILITIES=

# Worker name (must be unique per controller).
WORKER_NAME=worker-1
###< compose / worker deployment ###

###> TaskWeaver tunables (SPEC.md -> Configuration) ###
# Number of tool call rounds a step may take before it is considered to be looping.
TASKWEAVER_MAX_ROUNDS=50

# Seconds a step may stay `running` before it is considered expired.
TASKWEAVER_STEP_TIMEOUT=600

# Step context budget: max-context = request-size + output-buffer-size.
TASKWEAVER_CONTEXT_REQUEST_SIZE=6000
TASKWEAVER_CONTEXT_OUTPUT_BUFFER=1500

# Worker's LLM-call concurrency limit, issued to the worker in its config.
TASKWEAVER_LLM_MAX_CONCURRENCY=1

# One-time enrollment token workers present at provision time (Tier-0).
# Generate a strong one, e.g.:
#   openssl rand -hex 24
# Rotate it periodically; it is only used to bootstrap worker provisioning.
TASKWEAVER_ENROLLMENT_TOKEN=replace-me-with-a-long-random-token

# Timezone used by the scheduler. Empty → PHP system default timezone.
# v1 is single-tenant (no per-task timezone); this is stamped on each task.
TASKWEAVER_TIMEZONE=

# Base URL of the LLM.
#  - Unauthenticated local LLM (default): workers talk to it DIRECTLY over the
#    private network; TaskWeaver never sees model traffic.
#  - Keyed / external LLM: if TASKWEAVER_LLM_API_KEY is set, this is the
#    upstream TaskWeaver PROXIES to via /api/worker/llm (the controller holds
#    the key; workers never do).
TASKWEAVER_LLM_URL=http://llm:11434/v1
TASKWEAVER_LLM_MODEL=llama3.1

# API key for an external / keyed LLM provider (e.g. OpenAI, Anthropic, or a
# keyed LAN proxy). Held ONLY by the controller: read at request time, never
# persisted, never issued to workers. When set, workers' LLM traffic is
# proxied through the controller; leave empty for a direct unauthenticated
# local LLM.
TASKWEAVER_LLM_API_KEY=

# Optional system-prompt override issued to workers in their provision config.
TASKWEAVER_SYSTEM_PROMPT_OVERRIDE=
###< TaskWeaver tunables ###

###> MCP server credentials (v1: env vars only, names referenced in DB) ###
# Each McpServer row's cred_vars lists WHICH env vars map to its auth.
# Define one variable per external MCP server the controller proxies.
# NEVER commit real values — inject via your secrets manager / runtime.
# Example:
# MY_MCP_SERVER_TOKEN=real-secret-here
###< MCP server credentials ###
