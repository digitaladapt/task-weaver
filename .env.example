# TaskWeaver — production-ready environment template.
#
# COPY AND CUSTOMIZE — this file is a committed reference, NOT loaded by the
# app. In production there is no dotenv file; inject these as real
# environment variables via your runtime (container scheduler, secrets
# manager, systemd drop-in, etc.).
#
# For local development, see .env.dev (committed defaults) and your own
# uncommitted .env.dev.local / .env.local overrides.

# --- Environment -----------------------------------------------------------
# 'prod' disables the dev toolbar, inlines/enables opcache-friendly caches,
# and turns off detailed error pages.
APP_ENV=prod

# Symfony secret used to sign cookies / CSRF tokens / session data.
# MUST be unique per deployment and kept secret.
# Generate one with:
#   php -r "echo bin2hex(random_bytes(32));"
#   # or:  openssl rand -hex 32
# If you lose it, all sessions and signed values are invalidated.
APP_SECRET=replace-me-with-a-long-random-hex-string

# Shared writable directory for cross-process data (uploads, caches spillover).
# In production this should point at a persistent volume.
APP_SHARE_DIR=/var/lib/taskweaver/share

###> symfony/routing ###
# Canonical URL used to generate absolute URLs in CLI/background contexts.
DEFAULT_URI=https://taskweaver.example.com
###< symfony/routing ###

###> doctrine/doctrine-bundle ###
# SQLite is the only supported database in v1.
# The path must be writable by the web/worker process user; in a container it
# should live on a persistent volume. Health-check that the file exists at boot.
DATABASE_URL="sqlite:///%kernel.project_dir%/var/taskweaver.db"
###< doctrine/doctrine-bundle ###

###> symfony/messenger ###
# Messenger reuses the same SQLite DB as its transport.
# In production auto_setup should eventually be 0 once tables are migrated.
MESSENGER_TRANSPORT_DSN=doctrine://default
###< symfony/messenger ###

###> TaskWeaver tunables (SPEC.md -> Configuration) ###
# Seconds a step may stay `running` before it is considered expired.
TASKWEAVER_STEP_TIMEOUT=600

# Step context budget: max-context = request-size + output-buffer-size.
TASKWEAVER_CONTEXT_REQUEST_SIZE=6000
TASKWEAVER_CONTEXT_OUTPUT_BUFFER=1500

# Worker's LLM-call concurrency limit, issued to the worker in its config.
TASKWEAVER_LLM_MAX_CONCURRENCY=1

# One-time enrollment token workers present at provision time (Tier-0).
# Generate a strong one, e.g.:
#   openssl rand -hex 24
# Rotate it periodically; it is only used to bootstrap worker provisioning.
TASKWEAVER_ENROLLMENT_TOKEN=replace-me-with-a-long-random-token

# Base URL of the local (private-network) LLM the workers talk to directly.
# TaskWeaver never sees model traffic; workers reach this over the private net.
TASKWEAVER_LLM_URL=http://llm:11434/v1
###< TaskWeaver tunables ###

###> MCP server credentials (v1: env vars only, names referenced in DB) ###
# Each McpServer row's cred_vars lists WHICH env vars map to its auth.
# Define one variable per external MCP server the controller proxies.
# NEVER commit real values — inject via your secrets manager / runtime.
# Example:
# MY_MCP_SERVER_TOKEN=real-secret-here
###< MCP server credentials ###
