# TaskWeaver controller — dev-only environment template.
#
# This file is COMMITTED as a reference for local development only.
# symfony/dotenv is a DEV-ONLY dependency; production injects real
# environment variables (SPEC.md → Configuration). NEVER put real secrets here.
#
# To use: copy to .env.local and adjust (or rely on defaults in .env).

APP_ENV=dev
APP_SECRET=change-me-in-local

# SQLite is the only database in v1.
DATABASE_URL="sqlite:///%kernel.project_dir%/var/taskweaver.db"

# Messenger uses the same SQLite DB (doctrine transport).
MESSENGER_TRANSPORT_DSN=doctrine://default?auto_setup=1

# Seconds a step may stay `running` before lazy expiry.
TASKWEAVER_STEP_TIMEOUT=600

# Step context budget: max-context = request-size + output-buffer-size.
TASKWEAVER_CONTEXT_REQUEST_SIZE=6000
TASKWEAVER_CONTEXT_OUTPUT_BUFFER=1500

# Worker's LLM-call concurrency limit (issued to workers at provision).
TASKWEAVER_LLM_MAX_CONCURRENCY=1

# One-time enrollment token workers present at provision (Tier-0).
TASKWEAVER_ENROLLMENT_TOKEN=dev-enrollment-token

# Local LLM endpoint used in the worker config handed out at provision.
TASKWEAVER_LLM_URL=http://llm:11434/v1

# --- MCP server credentials (v1: env vars only, names referenced in DB) ---
# Each McpServer row's cred_vars lists WHICH env vars map to its auth.
# Example (uncomment for a real server):
# MY_MCP_SERVER_TOKEN=...
