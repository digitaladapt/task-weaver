# TaskWeaver — TEST environment (CI + local unit tests).
#
# Committed so CI (and local runs) get deterministic, safe values that never
# touch dev/prod data. CI: `cp .env.test .env`; tests/bootstrap.php also
# loads this file directly.

###> symfony/framework-bundle ###
APP_ENV=test
APP_SECRET=test-secret-not-for-production
APP_DEBUG=1
###< symfony/framework-bundle ###

###> symfony/routing ###
DEFAULT_URI=http://localhost
###< symfony/routing ###

###> doctrine/doctrine-bundle ###
# Tests are pure unit/component tests (no kernel boot in the current suite),
# so SQLite in-memory is the safest default; switch to a file DB if a
# functional suite is added.
DATABASE_URL="sqlite:///:memory:"
###< doctrine/doctrine-bundle ###

###> symfony/messenger ###
###< symfony/messenger ###

###> TaskWeaver tunables ###
# Test-safe values; the real deployment injects its own via env.
TASKWEAVER_TIMEZONE=UTC
TASKWEAVER_MAX_ROUNDS=50
TASKWEAVER_STEP_TIMEOUT=600
TASKWEAVER_CONTEXT_REQUEST_SIZE=6000
TASKWEAVER_CONTEXT_OUTPUT_BUFFER=1500
TASKWEAVER_LLM_MAX_CONCURRENCY=1
TASKWEAVER_ENROLLMENT_TOKEN=test-enrollment-token
TASKWEAVER_LLM_URL=http://llm:8080/v1
TASKWEAVER_LLM_MODEL=Qwen3.5-4B
TASKWEAVER_LLM_API_KEY=
TASKWEAVER_SYSTEM_PROMPT_OVERRIDE=
###< TaskWeaver tunables ###
